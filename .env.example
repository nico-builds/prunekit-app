# GitHub App (create at https://github.com/settings/apps/new)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./prunekit.private-key.pem
GITHUB_WEBHOOK_SECRET=

# Server
PORT=3000
NODE_ENV=development

# Public URLs (update after deploy)
APP_BASE_URL=https://your-app.example.com
ACTION_REPO=chiku524/prunekit-cleanup-action

# Support (required for Marketplace listing)
SUPPORT_EMAIL=support@example.com
